# The .env file for the interface project. Copy this file to `.env` and edit the values as needed.

# The URL path to the directory containing static assets, relative to the web root.
ASSET_PATH='/static/'

# A comma-separated allowlist of module names to include when building interface modules.
# Empty means include every module (a full build); set e.g. 'eeg' for a targeted distro.
# For a targeted distro, also add the omitted modules to the project-specific tsconfig `exclude` so the
# type-check matches the bundle.
INCLUDE_MODULES=''

# Name of the setup script to use, without file extension.
# The script must be located in `src/setups/` and be named `<name>.ts`.
SETUP='default'
