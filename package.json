{
  "name": "@epicurrents/interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/typecheck.mjs && vite build --config vite.config.dist.ts",
    "build:app": "node scripts/typecheck.mjs && vite build --config vite.config.app.ts",
    "build:custom": "node scripts/typecheck.mjs && vite build --config vite.config.custom.ts",
    "build:dist": "vite build --config vite.config.dist.ts",
    "dev": "vite --force",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "preview": "vite preview",
    "start": "vite --force",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./modules/eeg": {
      "import": "./dist/modules/eeg.js",
      "default": "./dist/modules/eeg.js"
    },
    "./modules/acc": {
      "import": "./dist/modules/acc.js",
      "default": "./dist/modules/acc.js"
    },
    "./modules/doc": {
      "import": "./dist/modules/doc.js",
      "default": "./dist/modules/doc.js"
    },
    "./modules/emg": {
      "import": "./dist/modules/emg.js",
      "default": "./dist/modules/emg.js"
    },
    "./modules/pdf": {
      "import": "./dist/modules/pdf.js",
      "default": "./dist/modules/pdf.js"
    },
    "./style.css": "./dist/style.css",
    "./types": "./dist/types/index.d.ts",
    "./package.json": "./package.json",
    "./dist/types": "./dist/types/index.d.ts"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "files": [
    "dist/*",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/epicurrents/interface.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "dependencies": {
    "@awesome.me/webawesome": "^3.9.0",
    "@material-symbols/svg-400": "^0.44.7",
    "dompurify": "^3.2.3",
    "lodash": "^4.17.23",
    "stream-browserify": "^3.0.0",
    "vite-plugin-singlefile": "^2.0.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vuex": "^4.1.0",
    "webpack-dev-server": "5.2.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@epicurrents/core": "^0.3.0 || ^1.0.0",
    "@types/lodash": "^4.17.23",
    "@vitejs/plugin-vue": "^6.0.2",
    "dotenv": "^17.3.1",
    "isomorphic-fetch": "^3.0.0",
    "scoped-event-bus": "^0.3.0 || ^1.0.0",
    "scoped-event-log": "^3.2.0",
    "tsconfig-replace-paths": "^0.0.14",
    "typescript": "5.7",
    "vite": "^7.3.1",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^4.2.3",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "@epicurrents/core": "^0.3.0 || ^1.0.0",
    "scoped-event-log": "^3.2.0"
  }
}
